{
  "name": "doctiplay-landing-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "install:ppt": "cd ppt-deck && npm install",
    "build:ppt": "cd ppt-deck && npm run build",
    "predeploy": "npm run install:ppt && npm run build:ppt && rm -rf public/pitch public/slides && mkdir -p public/pitch && cp -r ppt-deck/dist/* public/pitch/ && npm run build && touch dist/.nojekyll",
    "deploy": "gh-pages -d dist -t"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@google/genai": "latest",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
